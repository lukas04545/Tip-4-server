# Required: API key from the Tip4Serv dashboard (Store → API Keys)
TIP4SERV_API_KEY=
# Optional: API base URL (default https://api.tip4serv.com/v1)
TIP4SERV_API_BASE=
# Optional: path or URL of the Tip4Serv OpenAPI spec; adds one typed tool per endpoint
TIP4SERV_OPENAPI=
# Optional: set to true to expose only read operations
TIP4SERV_READ_ONLY=
